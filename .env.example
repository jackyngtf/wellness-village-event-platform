# Synthetic local mode requires no production resources, credentials or live
# integrations. The values below are website-Worker settings only; never put
# Google service-account or Sheet secrets in this file.

# The runnable portfolio uses local synthetic fixtures unless both values below
# are explicitly changed. Never commit a real organisation identifier.
THE_GROUND_LIVE_ENABLED=false
THE_GROUND_ORGANIZATION_ID=

# Native contact collection stays disabled unless every server-side gate and
# Cloudflare binding is configured. Never commit a populated secret.
PORTFOLIO_CONTACT_COLLECTION_ENABLED=false
PORTFOLIO_CONTACT_CONSENT_VERSION=portfolio-demo-contact-v1
PORTFOLIO_TURNSTILE_EXPECTED_HOSTNAME=portfolio.example.com
PORTFOLIO_TURNSTILE_SECRET_KEY=

# OPEN_NEXT_LOCAL_PREVIEW is set only by `npm run cf:preview`. Do not set it in
# a production build: normal builds use Durable Object revalidation.
