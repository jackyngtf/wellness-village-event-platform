{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "incremental": false,
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": [
      "@cloudflare/workers-types",
      "@cloudflare/vitest-plugin/types"
    ],
    "noEmit": true
  },
  "include": [
    "worker-configuration.d.ts",
    "src/**/*.ts",
    "vitest.config.ts"
  ]
}
